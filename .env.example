# ══════════════════════════════════════════════════════════════════════════════
# OpenDM - environment variables
#
# These are the ONLY secrets that live in the deployment environment.
# OpenDM owns one Meta app. Customers never enter its credentials; all OAuth
# connections use the values below on the server only.
# ══════════════════════════════════════════════════════════════════════════════

# ── Firebase Web App (Firebase Console → Project settings → Your apps) ─────
NEXT_PUBLIC_FIREBASE_API_KEY=your_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_web_app_id
GOOGLE_CLOUD_PROJECT=your-project-id
# Local development only: path to a Firebase Admin service-account JSON file
# stored OUTSIDE this repository. Never commit or paste the JSON into .env.
GOOGLE_APPLICATION_CREDENTIALS=C:\\secure\\opendm-firebase-admin.json

# ── Encryption key - 64 hex chars (32 bytes). Generate once with:
#    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Used to encrypt Instagram tokens + your Meta App Secret before they touch the DB.
# If you lose or change this key, you must reconnect Instagram and re-run setup.
TOKEN_ENCRYPTION_KEY=your_64_char_hex_key_here

# ── Cron secret - any long random string. Generate with:
#    node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Protects the background job-processing endpoint (/api/cron/process-jobs).
CRON_SECRET=your_random_cron_secret_here

# ── OpenDM's shared Meta app (server-only; never expose to customers) ────────
META_INSTAGRAM_APP_ID=your_instagram_app_id_here
META_INSTAGRAM_APP_SECRET=your_32_char_hex_instagram_app_secret_here
# Optional parent Meta/Facebook secret for webhook signatures:
# META_FACEBOOK_APP_SECRET=your_32_char_hex_facebook_app_secret_here
META_WEBHOOK_VERIFY_TOKEN=your_long_random_webhook_verify_token_here

# ── Public URL of THIS deployment (no trailing slash) ────────────────────────
# e.g. https://opendm.vercel.app or https://opendm.YOUR-SUBDOMAIN.workers.dev
NEXT_PUBLIC_APP_URL=https://your-deployment-url.example.com

# Optional comma-separated initial platform admins. Do not use browser input.
OPENDM_ADMIN_EMAILS=owner@your-domain.example

# ── Cloud Run + Cloud Tasks (set only on Cloud Run deployment) ──────────────
CLOUD_TASKS_LOCATION=asia-south1
CLOUD_TASKS_QUEUE=opendm-automation
CLOUD_TASKS_WORKER_URL=https://YOUR-WORKER-URL/api/tasks/automation
CLOUD_TASKS_WORKER_TOKEN=your_long_random_task_worker_token
# Never put a service-account JSON blob in this file or source control. Cloud
# Run uses an attached least-privilege service account / Application Default Credentials.
FIREBASE_AUTH_EMULATOR_HOST=
FIRESTORE_EMULATOR_HOST=
